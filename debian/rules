#!/usr/bin/make -f

export DH_VIRTUALENV_INSTALL_ROOT=/usr/share

%:
	dh $@ --with python-virtualenv

override_dh_virtualenv:
	# Temporary Debian 12 "Bookworm" fix
	# Only patch if the installed dh_virtualenv still needs it
	grep -q getargspec /usr/bin/dh_virtualenv && sudo sed -i 's/getargspec/getfullargspec/' /usr/bin/dh_virtualenv || true

	dh_virtualenv \
	--python /usr/bin/python3 \
	--use-system-packages \
	--builtin-venv \
	--upgrade-pip \
	--extra-pip-arg "--ignore-installed" \
	--extra-pip-arg "--no-cache-dir"

